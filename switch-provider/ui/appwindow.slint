import { ListView, HorizontalBox, VerticalBox, GridBox, LineEdit, TextEdit, ScrollView, Button } from "std-widgets.slint";

export struct ProviderInfo {
    name: string,
    is_active: bool,
    model: string,
    base_url: string,
}

export component AppWindow inherits Window {
    title: "Switch Provider v1.0.3";
    icon: @image-url("../assets/icon_256x256.png");
    preferred-width: 680px;
    preferred-height: 780px;
    min-width: 680px;
    min-height: 720px;
    background: #1a1a1a;

    in-out property <string> current-provider: "Nenhum";
    in-out property <string> current-model: "";
    in-out property <[ProviderInfo]> providers: [];
    in-out property <int> selected-index: -1;
    in-out property <string> status-message: "";
    in-out property <bool> is-loading: false;
    in-out property <bool> can-change-model: false;
    in-out property <string> settings-json: "";

    in-out property <int> add-step: 0;
    in-out property <int> selected-endpoint: 0;
    in-out property <string> new-provider-name: "";
    in-out property <string> new-provider-apikey: "";

    in-out property <bool> show-view-settings: false;
    in-out property <bool> show-rename: false;
    in-out property <int> rename-index: -1;
    in-out property <string> rename-new-name: "";
    in-out property <bool> show-remove-confirm: false;
    in-out property <int> remove-index: -1;
    in-out property <bool> show-change-model: false;
    in-out property <string> new-model-name: "";

    in-out property <[string]> available-models: [];
    in-out property <[string]> filtered-models: [];
    in-out property <int> model-selected-index: -1;
    in-out property <string> model-filter: "";

    callback on-select-provider(int);
    callback on-add-provider(int, string, string, string);
    callback on-remove-provider(int);
    callback on-rename-provider(int, string);
    callback on_view_settings();
    callback on-change-model(string);
    callback on-load-models();
    callback on-load-new-provider-models(int, string);
    callback on-filter-models(string);
    callback on-claude-login();
    callback on-exit();

    VerticalBox {
        padding: 20px;
        spacing: 16px;

        Text {
            text: "Provider Manager";
            font-size: 28px;
            font-weight: 900;
            color: #ffffff;
        }

        Rectangle {
            height: 46px;
            background: #2d2d2d;
            border-radius: 8px;
            VerticalBox {
                padding: 7px;
                spacing: 2px;
                Text {
                    text: "Provider Ativo: " + root.current-provider;
                    font-size: 14px;
                    font-weight: 700;
                    color: #55ff55;
                    overflow: elide;
                }
                Text {
                    text: root.current-model == "" ? "Modelo: (nao definido)" : "Modelo: " + root.current-model;
                    font-size: 12px;
                    color: #6699ff;
                    overflow: elide;
                }
            }
        }

        if root.show-view-settings: VerticalBox {
            spacing: 14px;
            Text { text: "Configuracoes Ativas"; font-size: 24px; font-weight: 800; color: #ffffff; }
            ScrollView {
                height: 500px;
                TextEdit {
                    text: root.settings-json;
                    read-only: true;
                    font-family: "Consolas";
                    font-size: 13px;
                }
            }
            Button { text: "Voltar"; height: 34px; clicked => { root.show-view-settings = false; } }
        }

        if root.show-rename: VerticalBox {
            spacing: 14px;
            Text { text: "Renomear Provider"; font-size: 24px; font-weight: 800; color: #ffffff; }
            if root.rename-index >= 0 && root.rename-index < root.providers.length: Text {
                text: "Atual: " + root.providers[root.rename-index].name;
                font-size: 16px;
                color: #aaaaaa;
                overflow: elide;
            }
            LineEdit { placeholder-text: "Novo nome para o provider"; text <=> root.rename-new-name; font-size: 18px; }
            HorizontalBox {
                spacing: 12px;
                Button { text: "Confirmar"; height: 34px; clicked => { on-rename-provider(root.rename-index, root.rename-new-name); root.show-rename = false; root.rename-new-name = ""; root.rename-index = -1; } }
                Button { text: "Cancelar"; height: 34px; clicked => { root.show-rename = false; root.rename-new-name = ""; root.rename-index = -1; } }
            }
        }

        if root.show-remove-confirm: VerticalBox {
            spacing: 14px;
            Text { text: "Confirmar Remocao"; font-size: 24px; font-weight: 800; color: #ff6666; }
            if root.remove-index >= 0 && root.remove-index < root.providers.length: Text {
                text: "Remover \"" + root.providers[root.remove-index].name + "\"?";
                font-size: 18px;
                color: #ffffff;
                overflow: elide;
            }
            Text { text: "Esta acao nao pode ser desfeita."; font-size: 15px; color: #ffcc66; }
            HorizontalBox {
                spacing: 12px;
                Button { text: "Remover"; height: 34px; clicked => { on-remove-provider(root.remove-index); root.show-remove-confirm = false; root.remove-index = -1; } }
                Button { text: "Cancelar"; height: 34px; clicked => { root.show-remove-confirm = false; root.remove-index = -1; } }
            }
        }

        if root.show-change-model: VerticalBox {
            spacing: 12px;
            Text { text: "Mudar Modelo"; font-size: 24px; font-weight: 800; color: #ffffff; }
            Text { text: "Provider: " + root.current-provider; font-size: 15px; color: #aaaaaa; overflow: elide; }
            Text { text: root.current-model == "" ? "Modelo atual: (nao definido)" : "Modelo atual: " + root.current-model; font-size: 15px; color: #6699ff; overflow: elide; }
            if !root.can-change-model: Text {
                text: "A troca dinamica esta disponivel para OpenRouter, OpenCode Zen e OpenCode Go.";
                font-size: 15px;
                color: #ffcc66;
                wrap: word-wrap;
            }
            Button { text: "Carregar modelos"; enabled: root.can-change-model; height: 34px; clicked => { on-load-models(); } }
            if root.available-models.length > 0: LineEdit {
                placeholder-text: "Filtrar modelos. Ex: kimi, claude, qwen";
                text <=> root.model-filter;
                font-size: 16px;
                edited => { on-filter-models(root.model-filter); }
            }
            if root.filtered-models.length > 0: ListView {
                height: 190px;
                for model[index] in root.filtered-models: Button {
                    height: 36px;
                    text: model;
                    clicked => {
                        root.model-selected-index = index;
                        root.new-model-name = model;
                    }
                }
            }
            if root.available-models.length > 0 && root.filtered-models.length == 0: Text {
                text: "Nenhum modelo encontrado para este filtro.";
                font-size: 15px;
                color: #ffcc66;
            }
            if root.new-model-name != "": Rectangle {
                height: 32px;
                background: #24314f;
                border-color: #6699ff;
                border-width: 1px;
                border-radius: 6px;
                Text { x: 10px; y: 7px; width: parent.width - 20px; text: "Selecionado: " + root.new-model-name; font-size: 13px; color: #ffffff; overflow: elide; }
            }
            LineEdit { placeholder-text: "Ou digite o modelo manualmente"; text <=> root.new-model-name; font-size: 17px; }
            HorizontalBox {
                spacing: 12px;
                Button { text: "Salvar modelo"; height: 34px; enabled: root.can-change-model && root.new-model-name != ""; clicked => { on-change-model(root.new-model-name); root.new-model-name = ""; root.model-selected-index = -1; root.available-models = []; root.filtered-models = []; root.model-filter = ""; } }
                Button { text: "Cancelar"; height: 34px; clicked => { root.show-change-model = false; root.new-model-name = ""; root.model-selected-index = -1; root.available-models = []; root.filtered-models = []; root.model-filter = ""; } }
            }
        }

        if root.add-step == 1: VerticalBox {
            spacing: 14px;
            Text { text: "Selecione o Tipo de Provider"; font-size: 24px; font-weight: 800; color: #ffffff; }
            GridBox {
                spacing: 10px;
                Row {
                    Button { text: "MiniMax"; height: 34px; clicked => { root.selected-endpoint = 1; root.add-step = 2; } }
                    Button { text: "OpenRouter"; height: 34px; clicked => { root.selected-endpoint = 2; root.add-step = 2; root.available-models = []; root.filtered-models = []; root.model-filter = ""; root.new-model-name = ""; } }
                    Button { text: "Anthropic"; height: 34px; clicked => { root.selected-endpoint = 3; root.add-step = 2; } }
                }
                Row {
                    Button { text: "Z.AI / GLM"; height: 34px; clicked => { root.selected-endpoint = 4; root.add-step = 2; } }
                    Button { text: "Google AI"; height: 34px; clicked => { root.selected-endpoint = 5; root.add-step = 2; } }
                    Button { text: "OpenAI"; height: 34px; clicked => { root.selected-endpoint = 6; root.add-step = 2; } }
                }
                Row {
                    Button { text: "OpenCode Zen"; height: 34px; clicked => { root.selected-endpoint = 8; root.add-step = 2; root.available-models = []; root.filtered-models = []; root.model-filter = ""; root.new-model-name = ""; } }
                    Button { text: "OpenCode Go"; height: 34px; clicked => { root.selected-endpoint = 9; root.add-step = 2; root.available-models = []; root.filtered-models = []; root.model-filter = ""; root.new-model-name = ""; } }
                    Button { text: "Custom"; height: 34px; clicked => { root.selected-endpoint = 7; root.add-step = 2; } }
                }
            }
            Button { text: "Voltar ao menu"; height: 34px; clicked => { root.add-step = 0; } }
        }

        if root.add-step == 2: VerticalBox {
            spacing: 14px;
            Text { text: "Nome do Provider"; font-size: 24px; font-weight: 800; color: #ffffff; }
            Text { text: "Escolha um nome para identificar este provider"; font-size: 14px; color: #aaaaaa; }
            LineEdit { placeholder-text: "Ex: Meu Provider"; text <=> root.new-provider-name; font-size: 20px; }
            HorizontalBox {
                spacing: 12px;
                Button { text: "Proximo"; height: 34px; enabled: root.new-provider-name != ""; clicked => { root.add-step = 3; } }
                Button { text: "Voltar"; height: 34px; clicked => { root.add-step = 1; root.new-provider-name = ""; } }
            }
        }

        if root.add-step == 3: VerticalBox {
            spacing: 12px;
            Text { text: (root.selected-endpoint == 2 || root.selected-endpoint == 8 || root.selected-endpoint == 9) ? "API Key e Modelo" : "API Key"; font-size: 24px; font-weight: 800; color: #ffffff; }
            if root.selected-endpoint == 8: Text {
                text: "OpenCode Zen: inclui modelos gratuitos e modelos maiores pagos com creditos da plataforma Zen.";
                font-size: 13px;
                color: #ffcc66;
                wrap: word-wrap;
            }
            if root.selected-endpoint == 9: Text {
                text: "OpenCode Go: requer assinatura OpenCode Go ativa.";
                font-size: 13px;
                color: #ffcc66;
                wrap: word-wrap;
            }
            if root.available-models.length == 0: LineEdit {
                placeholder-text: "Cole sua API key aqui...";
                text <=> root.new-provider-apikey;
                font-size: 18px;
            }
            if root.available-models.length > 0: Rectangle {
                height: 34px;
                background: #24314f;
                border-color: #6699ff;
                border-width: 1px;
                border-radius: 6px;
                Text {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    text: "API Key carregada e oculta";
                    font-size: 13px;
                    color: #ffffff;
                    overflow: elide;
                }
            }
            if root.selected-endpoint == 2 || root.selected-endpoint == 8 || root.selected-endpoint == 9: Button {
                text: root.selected-endpoint == 2 ? "Carregar modelos OpenRouter" : root.selected-endpoint == 8 ? "Carregar modelos OpenCode Zen" : "Carregar modelos OpenCode Go";
                height: 34px;
                enabled: root.new-provider-apikey != "" && root.available-models.length == 0;
                clicked => { on-load-new-provider-models(root.selected-endpoint, root.new-provider-apikey); }
            }
            if root.available-models.length > 0: Button {
                text: "Trocar API key";
                height: 30px;
                clicked => {
                    root.new-provider-apikey = "";
                    root.new-model-name = "";
                    root.available-models = [];
                    root.filtered-models = [];
                    root.model-filter = "";
                    root.model-selected-index = -1;
                }
            }
            if (root.selected-endpoint == 2 || root.selected-endpoint == 8 || root.selected-endpoint == 9) && root.available-models.length > 0: LineEdit {
                placeholder-text: "Filtrar modelos. Ex: kimi, claude, deepseek";
                text <=> root.model-filter;
                font-size: 16px;
                edited => { on-filter-models(root.model-filter); }
            }
            if (root.selected-endpoint == 2 || root.selected-endpoint == 8 || root.selected-endpoint == 9) && root.filtered-models.length > 0: ListView {
                height: 190px;
                for model[index] in root.filtered-models: Button {
                    height: 36px;
                    text: model;
                    clicked => {
                        root.model-selected-index = index;
                        root.new-model-name = model;
                    }
                }
            }
            if (root.selected-endpoint == 2 || root.selected-endpoint == 8 || root.selected-endpoint == 9) && root.new-model-name != "": Rectangle {
                height: 32px;
                background: #24314f;
                border-color: #6699ff;
                border-width: 1px;
                border-radius: 6px;
                Text { x: 10px; y: 7px; width: parent.width - 20px; text: "Modelo: " + root.new-model-name; font-size: 13px; color: #ffffff; overflow: elide; }
            }
            if root.selected-endpoint == 2 || root.selected-endpoint == 8 || root.selected-endpoint == 9: LineEdit {
                placeholder-text: root.selected-endpoint == 2 ? "Ou digite o modelo OpenRouter manualmente" : root.selected-endpoint == 8 ? "Ou digite o modelo Zen. Ex: kimi-k2.5" : "Ou digite o modelo Go. Ex: kimi-k2.6";
                text <=> root.new-model-name;
                font-size: 17px;
            }
            HorizontalBox {
                spacing: 12px;
                Button { text: "Proximo"; height: 34px; enabled: root.new-provider-apikey != "" && (!((root.selected-endpoint == 2 || root.selected-endpoint == 8 || root.selected-endpoint == 9)) || root.new-model-name != ""); clicked => { root.add-step = 4; } }
                Button { text: "Voltar"; height: 34px; clicked => { root.add-step = 2; root.new-provider-apikey = ""; root.available-models = []; root.filtered-models = []; root.model-filter = ""; root.new-model-name = ""; } }
            }
        }

        if root.add-step == 4: VerticalBox {
            spacing: 14px;
            Text { text: "Confirmar Provider"; font-size: 24px; font-weight: 800; color: #ffffff; }
            Rectangle {
                height: 118px;
                background: #2d2d2d;
                border-radius: 8px;
                VerticalBox {
                    padding: 12px;
                    spacing: 4px;
                    Text { text: "Nome: " + root.new-provider-name; font-size: 17px; font-weight: 600; color: #ffffff; overflow: elide; }
                    Text { text: "Tipo: " + (root.selected-endpoint == 1 ? "MiniMax" : root.selected-endpoint == 2 ? "OpenRouter" : root.selected-endpoint == 3 ? "Anthropic" : root.selected-endpoint == 4 ? "Z.AI" : root.selected-endpoint == 5 ? "Google AI" : root.selected-endpoint == 6 ? "OpenAI" : root.selected-endpoint == 8 ? "OpenCode Zen" : root.selected-endpoint == 9 ? "OpenCode Go" : "Custom"); font-size: 15px; color: #6699ff; }
                    if root.selected-endpoint == 2 || root.selected-endpoint == 8 || root.selected-endpoint == 9: Text { text: "Modelo: " + root.new-model-name; font-size: 13px; color: #aaaaaa; overflow: elide; }
                    Text { text: "API Key: [oculta]"; font-size: 13px; color: #888888; }
                }
            }
            HorizontalBox {
                spacing: 12px;
                Button { text: "Salvar e ativar"; height: 34px; clicked => { on-add-provider(root.selected-endpoint, root.new-provider-name, root.new-provider-apikey, root.new-model-name); root.add-step = 0; root.new-provider-name = ""; root.new-provider-apikey = ""; root.new-model-name = ""; root.selected-endpoint = 0; root.available-models = []; root.filtered-models = []; root.model-filter = ""; } }
                Button { text: "Cancelar"; height: 34px; clicked => { root.add-step = 0; root.new-provider-name = ""; root.new-provider-apikey = ""; root.new-model-name = ""; root.available-models = []; root.filtered-models = []; root.model-filter = ""; } }
            }
        }

        if root.add-step == 0 && !root.show-view-settings && !root.show-rename && !root.show-remove-confirm && !root.show-change-model: VerticalBox {
            spacing: 14px;
            Text { text: "Lista de Providers (" + root.providers.length + ")"; font-size: 22px; font-weight: 800; color: #ffffff; }
            if root.providers.length == 0: VerticalBox {
                padding: 40px;
                Text { text: "Nenhum provider cadastrado"; font-size: 20px; color: #888888; horizontal-alignment: center; }
                Text { text: "Use o botao Adicionar para criar um"; font-size: 16px; color: #6699ff; horizontal-alignment: center; }
            }
            ListView {
                height: 250px;
                for provider[index] in root.providers: TouchArea {
                    width: parent.width;
                    height: 78px;
                    clicked => { root.selected-index = index; }
                    Rectangle { width: parent.width; height: parent.height - 4px; background: root.selected-index == index ? #3355aa : #2d2d2d; border-radius: 8px; }
                    Text { x: 10px; y: 8px; width: parent.width - (provider.is_active ? 92px : 20px); text: provider.name; font-size: 16px; font-weight: 700; color: #ffffff; overflow: elide; }
                    Text { x: 10px; y: 34px; width: parent.width - 20px; text: provider.base_url != "" ? provider.base_url : provider.model; font-size: 12px; color: #aaaaaa; overflow: elide; }
                    if provider.model != "": Text { x: 10px; y: 53px; width: parent.width - 20px; text: provider.model; font-size: 11px; color: #777777; overflow: elide; }
                    if provider.is_active: Rectangle {
                        x: parent.width - 76px;
                        y: 9px;
                        width: 64px;
                        height: 22px;
                        background: #143d20;
                        border-color: #55ff55;
                        border-width: 1px;
                        border-radius: 4px;
                        Text { text: "ATIVO"; font-size: 11px; font-weight: 800; color: #55ff55; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        x: 8px;
                        y: parent.height - 2px;
                        width: parent.width - 16px;
                        height: 1px;
                        background: #3a3a3a;
                    }
                }
            }
            if root.selected-index >= 0: Text {
                text: "Selecionado: " + (root.selected-index < root.providers.length ? root.providers[root.selected-index].name : "");
                font-size: 15px;
                color: #6699ff;
                overflow: elide;
            }
            HorizontalBox {
                spacing: 10px;
                Button { text: "Ativar"; height: 34px; enabled: root.selected-index >= 0 && root.selected-index < root.providers.length; clicked => { on-select-provider(root.selected-index); root.selected-index = -1; } }
                Button { text: "Renomear"; height: 34px; enabled: root.selected-index >= 0; clicked => { root.show-rename = true; root.rename-index = root.selected-index; } }
                Button { text: "Remover"; height: 34px; enabled: root.selected-index >= 0; clicked => { root.show-remove-confirm = true; root.remove-index = root.selected-index; } }
            }
            HorizontalBox {
                spacing: 10px;
                Button { text: "Adicionar provider"; height: 34px; clicked => { root.add-step = 1; root.available-models = []; root.filtered-models = []; root.model-filter = ""; root.new-model-name = ""; } }
                Button {
                    text: "Mudar modelo";
                    height: 34px;
                    enabled: root.can-change-model;
                    clicked => {
                        root.show-change-model = true;
                        root.available-models = [];
                        root.filtered-models = [];
                        root.model-filter = "";
                        root.new-model-name = "";
                        on-load-models();
                    }
                }
            }
            HorizontalBox {
                spacing: 10px;
                Button { text: "Claude login"; height: 34px; clicked => { on-claude-login(); } }
                Button { text: "Ver configs"; height: 34px; clicked => { on-view_settings(); } }
                Button { text: "Sair"; height: 34px; clicked => { on-exit(); } }
            }
        }

        Rectangle {
            height: 36px;
            background: #333333;
            border-radius: 6px;
            Text {
                x: 8px;
                y: 9px;
                width: parent.width - 16px;
                text: root.status-message != "" ? root.status-message : "Pronto - selecione uma acao";
                font-size: 14px;
                color: #bbbbbb;
                overflow: elide;
            }
        }

        HorizontalBox {
            spacing: 8px;
            Text { text: "Switch Provider v1.0.3"; font-size: 12px; color: #888888; }
            Text { text: "|"; color: #555555; }
            Text { text: "Danubio Lagoa (2026)"; font-size: 12px; color: #888888; }
        }
    }
}
